# Copy to .env and fill in.
# Production example: postgresql://indieverse:STRONG_PASSWORD@localhost:5432/indieverse
DATABASE_URL="postgresql://USER@localhost/indieverse?host=/var/run/postgresql"

# Public address of the site, used for sitemap and share links.
SITE_URL="http://localhost:3000"

# Where uploaded cover images are stored. On a server, use an absolute path outside
# the app folder (e.g. /var/lib/indieverse/uploads) so redeploys never touch it.
UPLOAD_DIR="uploads"
